<UserControl x:Class="DocxEditor.Views.DocumentPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DocxEditor.Views"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:viewModels="clr-namespace:DocxEditor.ViewModels"
             xmlns:helpers="clr-namespace:DocxEditor.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewModels:DocumentVM}"
             d:DesignHeight="450" d:DesignWidth="800">
  <UserControl.Resources>
    <helpers:PropertiesViewNameCellStyleSelector x:Key="PropertiesViewNameCellStyleSelector"/>
    <helpers:PropertyEmptyToForegroundConverter x:Key="PropertyEmptyToForegroundConverter"/>
  </UserControl.Resources>
  <Grid Background="White">
    <syncfusion:PropertyGrid
      x:Name="propertyGrid"
      PropertyExpandMode="NestedMode"
      MenuButtonVisibility="true"
      AutoGeneratingPropertyGridItem="PropertyGrid_OnAutoGeneratingPropertyGridItem"
      UpdateSourceMode="ReturnOrLostFocus"
      SelectedObject="{Binding DocumentProperties.PropertiesProvider}"
      >
      <syncfusion:PropertyGrid.MenuItems>
        <MenuItem Header="Reset" Command="{Binding ResetCommand}" CommandParameter="{Binding}"/>
      </syncfusion:PropertyGrid.MenuItems>
    </syncfusion:PropertyGrid>
  </Grid>
</UserControl>
