<UserControl x:Class="DocxEditor.Views.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DocxEditor.Views"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:viewModels="clr-namespace:DocxEditor.ViewModels"
             xmlns:helpers="clr-namespace:DocxEditor.Helpers"
             xmlns:mvvm="clr-namespace:Qhta.MVVM;assembly=Qhta.MVVM"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewModels:DocumentVM}"
             d:DesignHeight="450" d:DesignWidth="800">
  <UserControl.Resources>
    <helpers:PropertiesViewNameCellStyleSelector x:Key="PropertiesViewNameCellStyleSelector"/>
    <helpers:PropertyEmptyToForegroundConverter x:Key="PropertyEmptyToForegroundConverter"/>
  </UserControl.Resources>
  <Grid >
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="5">
      <Grid.ColumnDefinitions >
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
        <Label Content="Select component" />
        <ComboBox Grid.Column="1" 
          ItemsSource="{Binding Components}"
          SelectedItem="{Binding SelectedComponent}"/>
    </Grid>
    <syncfusion:PropertyGrid
      x:Name="PropertyGrid"
      Grid.Row="1"
      Background="White"
      PropertyExpandMode="NestedMode"
      MenuButtonVisibility="true"
      AutoGenerateItems="True"
      AutoGeneratingPropertyGridItem="PropertyGrid_OnAutoGeneratingPropertyGridItem"
      UpdateSourceMode="ReturnOrLostFocus"
      SelectedObject="{Binding SelectedComponent}"
      CustomEditorCollection="{Binding CustomEditors}"
    >
      <syncfusion:PropertyGrid.MenuItems >
        <MenuItem Header="Reset" Command="{Binding ResetCommand}" CommandParameter="{Binding}"/>
      </syncfusion:PropertyGrid.MenuItems>
    </syncfusion:PropertyGrid>
  </Grid>
</UserControl>
